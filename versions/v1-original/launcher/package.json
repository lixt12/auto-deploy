{
  "name": "autodeploy-launcher",
  "version": "1.0.0",
  "description": "轻量版自动化部署系统启动器",
  "main": "launcher.js",
  "scripts": {
    "start": "node launcher.js",
    "build": "pkg launcher.js --target node18-win-x64 --output ../启动器.exe",
    "build-all": "pkg launcher.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path ../build"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "child_process": "^1.0.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "bin": {
    "autodeploy": "./launcher.js"
  },
  "pkg": {
    "assets": [
      "../backend-nodejs/**/*",
      "../frontend/**/*",
      "../electron/**/*"
    ],
    "scripts": [
      "../backend-nodejs/**/*.js",
      "../electron/**/*.js"
    ]
  }
}
