{
  "name": "auto-deploy-unified",
  "private": true,
  "version": "2.0.0",
  "description": "统一架构的自动化部署系统",
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend\"",
    "backend": "node src/backend/server.js",
    "backend:dev": "nodemon --signal SIGTERM --watch src/backend --ext js,json --ignore src/backend/data --ignore src/backend/logs src/backend/server.js",
    "frontend": "vite",
    "build": "vite build",
    "build-backend": "node scripts/build-backend.js",
    "build-electron": "node scripts/build-electron.js",
    "build-all": "npm run build-backend && npm run build && npm run build-electron",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build-all && electron-builder",
    "dist": "npm run build-all && electron-builder --publish=never",
    "clean": "rimraf dist dist-electron dist-backend dist-desktop node_modules/.vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.1",
    "antd": "^5.12.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "sql.js": "^1.8.0",
    "ssh2": "^1.17.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "main": "dist-electron/main.js",
  "homepage": "./",
  "build": {
    "appId": "com.sipsg.autodeploy.unified",
    "productName": "自动化部署系统",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-backend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-backend/",
        "to": "backend/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "自动化部署系统"
    }
  }
}
